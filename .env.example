# LLM
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=getnet-docs

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

# Langfuse (SDK keys — gerados na UI em localhost:3000)
LANGFUSE_ENABLED=false
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=http://langfuse:3000

# Langfuse self-hosted secrets (usados apenas pelo docker-compose)
LANGFUSE_NEXTAUTH_SECRET=changeme
LANGFUSE_SALT=changeme

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
APP_LOG_LEVEL=INFO
